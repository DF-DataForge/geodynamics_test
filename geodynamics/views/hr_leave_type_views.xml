<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_leave_type_form_inherit_geodynamics" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.geodynamics</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="df_geodynamics_name"/>
                <field name="df_geodynamics_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
