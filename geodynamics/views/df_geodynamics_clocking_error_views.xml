<odoo>
    <!-- List View -->
    <record id="view_geodynamics_clocking_error_list" model="ir.ui.view">
        <field name="name">geodynamics.clocking.possible.error.list</field>
        <field name="model">geodynamics.clocking.possible.error</field>
        <field name="arch" type="xml">
            <list string="Clocking Errors" decoration-danger="status=='to_check'" decoration-success="status=='approved'" decoration-muted="status=='ignore'">
                <header>
                    <button name="action_view_day_clockings"
                            type="object"
                            string="View Day Clockings"
                            help="Show all clockings for employees on this date"/>
                </header>
                <field name="error_date"/>
                <field name="project_code"/>
                <field name="message"/>
                <field name="employee_details"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_geodynamics_clocking_error_form" model="ir.ui.view">
        <field name="name">geodynamics.clocking.possible.error.form</field>
        <field name="model">geodynamics.clocking.possible.error</field>
        <field name="arch" type="xml">
            <form string="Clocking Error">
                <header>
                    <button name="action_view_day_clockings"
                            type="object"
                            string="View Day Clockings"
                            class="btn-primary"
                            help="Show all clockings for employees on this date, grouped by employee"/>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="error_date"/>
                            <field name="project_code"/>
                            <field name="message"/>
                        </group>
                        <group>
                            <field name="employee_details" widget="text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Related Clockings">
                            <field name="clocking_ids">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="date_local"/>
                                    <field name="movement_time_minutes"/>
                                    <field name="movement_time_hours"/>
                                    <field name="job_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_geodynamics_clocking_error_search" model="ir.ui.view">
        <field name="name">geodynamics.clocking.possible.error.search</field>
        <field name="model">geodynamics.clocking.possible.error</field>
        <field name="arch" type="xml">
            <search string="Search Clocking Errors">
                <field name="error_date"/>
                <field name="project_code"/>
                <field name="status"/>
                <filter name="filter_to_check" string="Te controleren" domain="[('status', '=', 'to_check')]"/>
                <filter name="filter_approved" string="Goedgekeurd" domain="[('status', '=', 'approved')]"/>
                <filter name="filter_fixed" string="Rechtgezet" domain="[('status', '=', 'fixed')]"/>
                <filter name="filter_ignore" string="Negeren" domain="[('status', '=', 'ignore')]"/>
                <group>
                    <filter name="group_by_date" string="Date" domain="[]" context="{'group_by': 'error_date'}"/>
                    <filter name="group_by_project" string="Project" domain="[]" context="{'group_by': 'project_code'}"/>
                    <filter name="group_by_status" string="Status" domain="[]" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_geodynamics_clocking_error" model="ir.actions.act_window">
        <field name="name">Clocking Errors</field>
        <field name="res_model">geodynamics.clocking.possible.error</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_to_check': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No clocking errors detected</p>
            <p>Errors will appear here when employees working on the same project have more than 5% time difference.</p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_geodynamics_clocking_errors"
              name="Clocking Errors"
              parent="menu_geodynamics_root"
              action="action_geodynamics_clocking_error"
              sequence="20"/>
</odoo>
