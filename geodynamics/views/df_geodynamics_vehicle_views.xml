<odoo>
    <record id="view_df_geodynamics_vehicle_tree" model="ir.ui.view">
        <field name="name">df.geodynamics.vehicle.tree</field>
        <field name="model">df.geodynamics.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <header>
                    <button name="action_gd_export_vehicles" type="object"
                            string="Export to Geodynamics"
                            icon="fa-upload"
                            groups="base.group_system"/>
                </header>
                <field name="df_code"/>
                <field name="df_name"/>
                <field name="df_license_plate"/>
                <field name="df_brand"/>
                <field name="df_model_name"/>
                <field name="df_vehicle_type"/>
                <field name="df_last_sync_date"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_df_geodynamics_vehicle_form" model="ir.ui.view">
        <field name="name">df.geodynamics.vehicle.form</field>
        <field name="model">df.geodynamics.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <group>
                        <group>
                            <field name="df_name"/>
                            <field name="df_code"/>
                            <field name="df_license_plate"/>
                            <field name="df_brand"/>
                            <field name="df_model_name"/>
                        </group>
                        <group>
                            <field name="df_vehicle_type"/>
                            <field name="df_geodynamics_id"/>
                            <field name="active"/>
                            <field name="df_last_sync_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Data">
                            <field name="df_raw_payload" widget="json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_df_geodynamics_vehicle_search" model="ir.ui.view">
        <field name="name">df.geodynamics.vehicle.search</field>
        <field name="model">df.geodynamics.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="df_name"/>
                <field name="df_code"/>
                <field name="df_license_plate"/>
                <field name="df_brand"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_df_geodynamics_vehicle" model="ir.actions.act_window">
        <field name="name">Fleet / Vehicles</field>
        <field name="res_model">df.geodynamics.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_df_geodynamics_vehicle" name="Fleet / Vehicles"
              parent="geodynamics.menu_root" sequence="60"
              action="action_df_geodynamics_vehicle"/>
</odoo>
