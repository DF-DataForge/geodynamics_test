<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Geodynamics Synch Wizard Form View -->
    <record id="view_geodynamics_synch_wizard_form" model="ir.ui.view">
        <field name="name">geodynamics.synch.wizard.form</field>
        <field name="model">geodynamics.synch.wizard</field>
        <field name="arch" type="xml">
            <form string="Synchronize Clockings">
                <group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_sync" string="Sync" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_geodynamics_synch_wizard" model="ir.actions.act_window">
        <field name="name">Synchronize Clockings</field>
        <field name="res_model">geodynamics.synch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_geodynamics_synch_wizard" name="Synchronize Clockings" parent="menu_geodynamics_root" action="geodynamics.action_geodynamics_synch_wizard" sequence="10"/>

</odoo>
