<odoo>
    <!-- Form View -->
    <record id="view_df_geodynamics_planning_form" model="ir.ui.view">
        <field name="name">df.geodynamics.planning.form</field>
        <field name="model">df.geodynamics.planning</field>
        <field name="arch" type="xml">
            <form string="Geodynamics Planning">
                <sheet>
                    <group>
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                        <field name="id_geodynamics"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_df_geodynamics_planning_tree" model="ir.ui.view">
        <field name="name">df.geodynamics.planning.list</field>
        <field name="model">df.geodynamics.planning</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button name="removePlanning" type="object" string="Verwijder planning item in Geodynamics"/>
                </header>
                <field name="create_date"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="id_geodynamics"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="task_id"/>
                <field name="activitynumber"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_df_geodynamics" model="ir.actions.act_window">
        <field name="name">Geodynamics Planning</field>
        <field name="res_model">df.geodynamics.planning</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu Item -->
    <menuitem name="Planningen" id="geodynamics.lst_planningen" parent="geodynamics.menu_root"
              action="action_df_geodynamics"/>
</odoo>
