#. module: geodynamics
msgid "Connection Settings"
msgstr "Verbindingsinstellingen"

#. module: geodynamics
msgid "API Credentials"
msgstr "API-inloggegevens"

#. module: geodynamics
msgid "Configure the connection to the Geodynamics / IntelliTracer API. Enter your company name, API username and password as provided by Geodynamics."
msgstr "Configureer de verbinding met de Geodynamics / IntelliTracer API. Vul uw bedrijfsnaam, API-gebruikersnaam en wachtwoord in zoals verstrekt door Geodynamics."

#. module: geodynamics
msgid "Company"
msgstr "Bedrijf"

#. module: geodynamics
msgid "Username"
msgstr "Gebruikersnaam"

#. module: geodynamics
msgid "Password"
msgstr "Wachtwoord"

#. module: geodynamics
msgid "Test Connection"
msgstr "Test verbinding"

#. module: geodynamics
msgid "Synchronization"
msgstr "Synchronisatie"

#. module: geodynamics
msgid "Clocking Sync"
msgstr "Kloksynchronisatie"

#. module: geodynamics
msgid "Configure automatic daily synchronization of clocking records from Geodynamics. Set how many days back the daily cron should fetch data."
msgstr "Configureer automatische dagelijkse synchronisatie van klokregistraties vanuit Geodynamics. Stel in hoeveel dagen terug de dagelijkse taak gegevens moet ophalen."

#. module: geodynamics
msgid "Days to sync back"
msgstr "Dagen terug synchroniseren"

#. module: geodynamics
msgid "Load Plannings from Geodynamics"
msgstr "Planningen laden uit Geodynamics"

#. module: geodynamics
msgid "Employee Sync"
msgstr "Werknemerssynchronisatie"

#. module: geodynamics
msgid "Synchronize employees between Odoo and Geodynamics. When enabled, employees are automatically matched by email address during sync."
msgstr "Synchroniseer werknemers tussen Odoo en Geodynamics. Indien ingeschakeld worden werknemers automatisch gekoppeld op basis van e-mailadres."

#. module: geodynamics
msgid "Fleet Sync"
msgstr "Wagenparksynchronisatie"

#. module: geodynamics
msgid "Import vehicles and resources from Geodynamics. When enabled, vehicles are automatically synchronized."
msgstr "Importeer voertuigen en middelen uit Geodynamics. Indien ingeschakeld worden voertuigen automatisch gesynchroniseerd."

#. module: geodynamics
msgid "POI Management"
msgstr "POI-beheer"

#. module: geodynamics
msgid "Load POI Types"
msgstr "POI-types laden"

#. module: geodynamics
msgid "Checkin at Work"
msgstr "Checkin at Work"

#. module: geodynamics
msgid "Import construction site check-in records (Checkinatwork / CIAW) from Geodynamics. Required for Belgian construction sector compliance."
msgstr "Importeer werfaanmeldingen (Checkinatwork / CIAW) uit Geodynamics. Vereist voor de Belgische bouwsector."

#. module: geodynamics
msgid "Planning Configuration"
msgstr "Planningconfiguratie"

#. module: geodynamics
msgid "Planning Mode"
msgstr "Planningsmodus"

#. module: geodynamics
msgid "Choose whether planning is managed at the task level or at the project level. Task-based: each task is planned individually. Project-based: planning is managed from the project."
msgstr "Kies of de planning wordt beheerd op taakniveau of op projectniveau. Taakgebaseerd: elke taak wordt individueel gepland. Projectgebaseerd: de planning wordt vanuit het project beheerd."

